# Lab 2 — copie para .env e ajuste. NUNCA commite o .env.
# Todos os valores abaixo sao de desenvolvimento LOCAL com dados ficticios.

# --- Postgres (docker-compose) ---
POSTGRES_USER=techpix
POSTGRES_PASSWORD=techpix-local-dev

# --- Langfuse server (docker-compose) ---
LANGFUSE_NEXTAUTH_SECRET=troque-por-um-segredo-local
LANGFUSE_SALT=troque-por-um-salt-local

# --- Chatbot (chatbot/app) ---
TECHPIX_OLLAMA_BASE_URL=http://localhost:11434
TECHPIX_CHAT_MODEL=qwen2.5:3b-instruct
TECHPIX_EMBEDDING_MODEL=nomic-embed-text
TECHPIX_DATABASE_URL=postgresql+psycopg://techpix:techpix-local-dev@localhost:5433/techpix

# --- Langfuse SDK (opcional: crie projeto na UI http://localhost:3000 e cole as chaves) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Evals ---
TECHPIX_API_URL=http://localhost:8080
EVALS_JUDGE=0
